@using System.Text.Json
@using System.Text.Json.Serialization

<div class="phone-frame">
    <div class="d-flex flex-column align-items-center px-4 py-5" style="min-height:560px;@_bodyStyle">

        @if (!string.IsNullOrEmpty(Page.AvatarUrl))
        {
            <img src="@Page.AvatarUrl" alt="avatar"
                 style="width:88px;height:88px;object-fit:cover;border-radius:@_avatarRadius;border:3px solid rgba(255,255,255,.3);margin-bottom:12px" />
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center"
                 style="width:88px;height:88px;border-radius:@_avatarRadius;background:rgba(128,128,128,.2);margin-bottom:12px">
                <i class="bi bi-person-fill" style="font-size:2.5rem;color:@_textColor"></i>
            </div>
        }

        <h5 class="fw-bold mb-1 text-center" style="color:@_textColor;font-family:@_titleFont">@Page.Title</h5>

        @if (!string.IsNullOrEmpty(Page.Bio))
        {
            <p class="text-center mb-3" style="color:@_textColor;opacity:.75;font-size:.875rem;line-height:1.4">@Page.Bio</p>
        }

        <div class="w-100 d-flex flex-column gap-2 mt-2">
            @foreach (var link in Links.Where(l => l.IsActive))
            {
                <div class="text-center py-2 px-3 w-100" style="@_btnStyle;cursor:pointer">
                    @link.Title
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public PageDto Page { get; set; } = default!;
    [Parameter] public List<LinkDto> Links { get; set; } = [];

    string _bodyStyle = "background:#ffffff";
    string _btnStyle = "background:#111;color:#fff;border-radius:8px";
    string _textColor = "#111111";
    string _titleFont = "inter, sans-serif";
    string _avatarRadius = "50%";

    protected override void OnParametersSet() => ParseTheme();

    void ParseTheme()
    {
        try
        {
            var cfg = JsonDocument.Parse(Page.ThemeConfig).RootElement;
            string Get(string key, string fb) => cfg.TryGetProperty(key, out var v) ? v.GetString() ?? fb : fb;

            var themeId   = Get("themeId",          "minimal-light");
            var bgColor   = Get("bgColor",           "#ffffff");
            var btnColor  = Get("buttonColor",       "#111111");
            var btnText   = Get("buttonTextColor",   "#ffffff");
            var btnStyle  = Get("buttonStyle",       "rounded");
            _textColor    = Get("textColor",         "#111111");
            _titleFont    = Get("titleFont",         "inter") + ", sans-serif";
            var avatarShape = Get("avatarShape",     "circle");

            _avatarRadius = avatarShape == "square" ? "10px" : "50%";

            _bodyStyle = themeId switch {
                "gradient-sunset" => "background:linear-gradient(135deg,#ffecd2,#fcb69f)",
                "gradient-ocean"  => "background:linear-gradient(135deg,#667eea,#764ba2)",
                "glass-morphism"  => $"background:{bgColor}",
                _                 => $"background:{bgColor}"
            };

            var radius = btnStyle switch { "pill" => "50px", "square" => "4px", _ => "10px" };
            _btnStyle = btnStyle == "outline"
                ? $"border:2px solid {btnColor};background:transparent;color:{btnColor};border-radius:{radius};font-weight:600"
                : $"background:{btnColor};color:{btnText};border:none;border-radius:{radius};font-weight:600";
        }
        catch { /* keep defaults */ }
    }
}
