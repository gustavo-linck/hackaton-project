@if (Visible)
{
    <div class="modal-theme-backdrop" @onclick="Cancel">
        <div class="modal-theme" @onclick:stopPropagation="true">
            <div class="modal-theme-header">
                <h5>@Title</h5>
                <button class="btn-ghost" style="padding:.25rem .5rem" @onclick="Cancel">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-theme-body text-theme-secondary">@Message</div>
            <div class="modal-theme-footer">
                <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
                <button class="btn @ConfirmClass" @onclick="Confirm">@ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar";
    [Parameter] public string Message { get; set; } = "Tem certeza?";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public string ConfirmClass { get; set; } = "btn-danger";
    [Parameter] public EventCallback OnConfirm { get; set; }

    async Task Confirm()
    {
        await VisibleChanged.InvokeAsync(false);
        await OnConfirm.InvokeAsync();
    }

    async Task Cancel() => await VisibleChanged.InvokeAsync(false);
}
