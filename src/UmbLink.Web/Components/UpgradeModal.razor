@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-stars me-2 text-warning"></i>Limite atingido</h5>
                    <button class="btn-close" @onclick="() => VisibleChanged.InvokeAsync(false)"></button>
                </div>
                <div class="modal-body">
                    <p>@Message</p>
                    <p class="text-muted small">Faça upgrade para continuar criando.</p>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="() => VisibleChanged.InvokeAsync(false)">Fechar</button>
                    <a href="/plans" class="btn btn-primary">Ver planos</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Message { get; set; } = "Você atingiu o limite do seu plano atual.";
}
