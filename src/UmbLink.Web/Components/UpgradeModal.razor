@if (Visible)
{
    <div class="modal-theme-backdrop" @onclick="() => VisibleChanged.InvokeAsync(false)">
        <div class="modal-theme" @onclick:stopPropagation="true">
            <div class="modal-theme-header" style="border-bottom:none">
                <h5><i class="bi bi-stars me-2 text-warning"></i>Limite atingido</h5>
                <button class="btn-ghost" style="padding:.25rem .5rem" @onclick="() => VisibleChanged.InvokeAsync(false)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-theme-body">
                <p class="mb-1">@Message</p>
                <p class="text-theme-muted small mb-0">Faça upgrade para continuar criando.</p>
            </div>
            <div class="modal-theme-footer" style="border-top:none">
                <button class="btn btn-secondary" @onclick="() => VisibleChanged.InvokeAsync(false)">Fechar</button>
                <a href="/plans" class="btn btn-primary">Ver planos</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Message { get; set; } = "Você atingiu o limite do seu plano atual.";
}
