@if (TrialEndsAt.HasValue && TrialEndsAt.Value > DateTime.UtcNow)
{
    var days = (int)Math.Ceiling((TrialEndsAt.Value - DateTime.UtcNow).TotalDays);
    <div class="alert-theme mb-0" style="border-radius:0;text-align:center;padding:.5rem 1rem">
        <i class="bi bi-clock me-1"></i>
        Seu trial termina em <strong>@days dia(s)</strong>.
        <a href="/plans" style="color:var(--accent);font-weight:600" class="ms-1">Assinar agora</a>
    </div>
}

@code {
    [Parameter] public DateTime? TrialEndsAt { get; set; }
}
