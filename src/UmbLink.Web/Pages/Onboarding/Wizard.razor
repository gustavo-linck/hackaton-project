@page "/onboarding"
@layout PublicLayout
@attribute [Authorize]
@inject IPageService PageSvc
@inject ILinkService LinkSvc
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Bem-vindo — UmbLink</PageTitle>

<div class="min-vh-100 d-flex flex-column" style="background:var(--bg-primary)">
    <!-- Navbar -->
    <nav class="d-flex align-items-center px-4 py-3" style="border-bottom:1px solid var(--border)">
        <span style="font-weight:800;font-size:1.25rem;color:var(--accent)">UmbLink</span>
    </nav>

    <!-- Progress bar -->
    <div class="px-4 pt-3" style="max-width:700px;margin:0 auto;width:100%">
        <div class="d-flex align-items-center gap-2 mb-1">
            @for (int i = 1; i <= TotalVisualSteps; i++)
            {
                var step = i;
                <div style="flex:1;height:4px;border-radius:4px;background:@(step <= VisualStep ? "var(--accent)" : "var(--border)");transition:background .4s ease"></div>
            }
        </div>
        <p class="text-theme-secondary" style="font-size:.75rem;margin:0">Passo @VisualStep de @TotalVisualSteps</p>
    </div>

    <!-- Content -->
    <div class="flex-grow-1 d-flex align-items-start justify-content-center px-3 py-4">
        <div class="onboarding-step-container" style="width:100%;max-width:@StepMaxWidth">

            @* ───── Step 1: Profile type ───── *@
            @if (_step == 1)
            {
                <div class="animate-fade-in-up">
                    <div class="text-center mb-4">
                        <h3 style="font-weight:700;color:var(--text-primary)">Qual é o seu perfil?</h3>
                        <p class="text-theme-secondary">Isso nos ajuda a sugerir o melhor template para você.</p>
                    </div>

                    <div class="row g-3 justify-content-center">
                        @foreach (var (id, label, icon, desc) in _profileTypes)
                        {
                            <div class="col-6 col-md-4">
                                <div style="border:2px solid @(_selectedProfile == id ? "var(--accent)" : "var(--border)");
                                            border-radius:14px;padding:1.25rem 1rem;cursor:pointer;text-align:center;
                                            background:@(_selectedProfile == id ? "rgba(99,102,241,0.06)" : "var(--bg-card)");
                                            transition:all .25s ease"
                                     @onclick="() => _selectedProfile = id">
                                    <i class="bi @icon" style="font-size:1.75rem;color:var(--accent);display:block;margin-bottom:.5rem"></i>
                                    <span style="font-weight:600;color:var(--text-primary);font-size:.9rem;display:block">@label</span>
                                    <span style="font-size:.7rem;color:var(--text-secondary)">@desc</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn-accent" @onclick="GoToStep2" disabled="@(string.IsNullOrEmpty(_selectedProfile))">
                            Continuar <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }

            @* ───── Step 2: Choose template ───── *@
            @if (_step == 2)
            {
                <div class="animate-fade-in-up">
                    <div class="text-center mb-4">
                        <h3 style="font-weight:700;color:var(--text-primary)">Escolha um template</h3>
                        <p class="text-theme-secondary">Você pode personalizar tudo depois no editor.</p>
                    </div>

                    <!-- Category filter -->
                    <div class="d-flex gap-1 mb-3 flex-wrap justify-content-center">
                        @foreach (var cat in Templates.Categories)
                        {
                            <button type="button"
                                    class="@(_templateFilter == cat ? "btn-accent" : "btn-ghost")"
                                    style="font-size:.75rem;padding:.3rem .75rem;text-transform:capitalize"
                                    @onclick="() => _templateFilter = cat">
                                @cat
                            </button>
                        }
                    </div>

                    <div class="row g-3">
                        <!-- Blank -->
                        <div class="col-sm-6 col-md-4">
                            <div style="border:2px solid @(_selectedTemplateId == null ? "var(--accent)" : "var(--border)");
                                        border-radius:14px;padding:1.25rem;cursor:pointer;text-align:center;
                                        background:@(_selectedTemplateId == null ? "rgba(99,102,241,0.06)" : "var(--bg-card)");
                                        transition:all .25s ease;min-height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem"
                                 @onclick="() => _selectedTemplateId = null">
                                <i class="bi bi-plus-circle" style="font-size:1.5rem;color:var(--accent)"></i>
                                <span style="font-weight:600;color:var(--text-primary);font-size:.85rem">Em branco</span>
                                <span style="font-size:.7rem;color:var(--text-secondary)">Começar do zero</span>
                            </div>
                        </div>
                        @foreach (var tpl in FilteredTemplates)
                        {
                            <div class="col-sm-6 col-md-4">
                                <div style="border:2px solid @(_selectedTemplateId == tpl.Id ? "var(--accent)" : "var(--border)");
                                            border-radius:14px;padding:1.25rem;cursor:pointer;text-align:center;
                                            background:@(_selectedTemplateId == tpl.Id ? "rgba(99,102,241,0.06)" : "var(--bg-card)");
                                            transition:all .25s ease;min-height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem"
                                     @onclick="() => _selectedTemplateId = tpl.Id">
                                    <i class="bi @tpl.Icon" style="font-size:1.5rem;color:var(--accent)"></i>
                                    <span style="font-weight:600;color:var(--text-primary);font-size:.85rem">@tpl.Name</span>
                                    <span style="font-size:.7rem;color:var(--text-secondary)">@tpl.Description</span>
                                    @if (_selectedTemplateId == tpl.Id)
                                    {
                                        <i class="bi bi-check-circle-fill" style="color:var(--accent);font-size:.9rem"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button class="btn-ghost" @onclick="() => _step = 1"><i class="bi bi-arrow-left me-1"></i> Voltar</button>
                        <button class="btn-accent" @onclick="() => _step = 3">Continuar <i class="bi bi-arrow-right ms-1"></i></button>
                    </div>
                </div>
            }

            @* ───── Step 3: Page details ───── *@
            @if (_step == 3)
            {
                <div class="animate-fade-in-up">
                    <div class="row g-4 justify-content-center">
                        <div class="col-12 col-lg-7">
                            <h3 style="font-weight:700;color:var(--text-primary);margin-bottom:.25rem">Detalhes da sua página</h3>
                            <p class="text-theme-secondary mb-4">Dê um nome e endereço para sua página.</p>

                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <div class="alert-theme" style="margin-bottom:1rem;border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08)">
                                    <i class="bi bi-exclamation-circle" style="color:var(--danger)"></i> @_error
                                </div>
                            }

                            <div style="margin-bottom:1rem">
                                <label class="form-label-theme" style="font-weight:600">Seu nome ou marca</label>
                                <input class="form-control-theme w-100" placeholder="Meu Nome" value="@_pageTitle" @oninput="OnTitleInput" maxlength="60" />
                                <div style="font-size:.7rem;text-align:right;color:@(_pageTitle.Length >= 54 ? "var(--danger)" : "var(--text-muted)")">@_pageTitle.Length / 60</div>
                            </div>

                            <div style="margin-bottom:1rem">
                                <label class="form-label-theme" style="font-weight:600">Endereço da página</label>
                                <div class="d-flex">
                                    <span class="form-control-theme d-flex align-items-center text-theme-muted"
                                          style="border-radius:10px 0 0 10px;border-right:none;font-size:.8rem;padding:.5rem .625rem;white-space:nowrap">@PublicPagePrefix</span>
                                    <input class="form-control-theme w-100" style="border-radius:0 10px 10px 0"
                                           placeholder="meu-slug" value="@_pageSlug" @oninput="OnSlugInput" maxlength="30" />
                                </div>
                                <div style="font-size:.7rem;text-align:right;color:@(_pageSlug.Length >= 27 ? "var(--danger)" : "var(--text-muted)")">@_pageSlug.Length / 30</div>
                            </div>

                            <div style="margin-bottom:1rem">
                                <label class="form-label-theme" style="font-weight:600">Bio (opcional)</label>
                                <textarea class="form-control-theme w-100" rows="2" value="@_pageBio" @oninput="e => _pageBio = e.Value?.ToString() ?? string.Empty" placeholder="Uma breve descrição sobre você..." maxlength="200"></textarea>
                                <div style="font-size:.7rem;text-align:right;color:@(_pageBio.Length >= 180 ? "var(--danger)" : "var(--text-muted)")">@_pageBio.Length / 200</div>
                            </div>

                            <!-- AI section -->
                            <div style="border:1px solid var(--border);border-radius:12px;padding:1rem;margin-bottom:1rem;background:rgba(99,102,241,0.04)">
                                <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem">
                                    <i class="bi bi-stars" style="color:var(--accent)"></i>
                                    <span style="font-weight:600;font-size:.85rem;color:var(--text-primary)">Quer uma ajuda? Gere com IA</span>
                                </div>
                                <textarea class="form-control-theme w-100" rows="2"
                                          placeholder="Descreva quem você é em uma frase..."
                                          @bind="_aiDescription" style="margin-bottom:.5rem" />
                                @if (!string.IsNullOrEmpty(_aiError))
                                {
                                    <div style="font-size:.75rem;color:var(--danger);margin-bottom:.5rem">@_aiError</div>
                                }
                                @if (!string.IsNullOrEmpty(_aiSuccessMsg))
                                {
                                    <div style="font-size:.75rem;color:var(--success);margin-bottom:.5rem">@_aiSuccessMsg</div>
                                }
                                <button class="btn-accent" style="font-size:.8rem;padding:.35rem .875rem"
                                        @onclick="GenerateWithAI" disabled="@(_aiLoading || _aiCallCount >= 3)">
                                    @if (_aiLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-stars me-1"></i>
                                    }
                                    @(_aiCallCount >= 3 ? "Limite atingido" : "Gerar com IA")
                                </button>
                                @if (_aiCallCount > 0)
                                {
                                    <span style="font-size:.7rem;color:var(--text-muted);margin-left:.5rem">
                                        @_aiCallCount / 3 usos
                                    </span>
                                }
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn-ghost" @onclick="() => _step = 2"><i class="bi bi-arrow-left me-1"></i> Voltar</button>
                                <button class="btn-accent" @onclick="CreatePageAsync" disabled="@_creating">
                                    @if (_creating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Criar minha página <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Live preview (desktop) -->
                        <div class="col-lg-5 d-none d-lg-flex flex-column align-items-center justify-content-start pt-3">
                            <PagePreview Page="GetPreviewDto()" Links="[]" />
                            <small class="text-theme-muted mt-2">Preview ao vivo</small>
                        </div>
                    </div>
                </div>
            }

            @* ───── Step 4: Add initial links ───── *@
            @if (_step == 4)
            {
                <div class="animate-fade-in-up">
                    <div class="text-center mb-4">
                        <h3 style="font-weight:700;color:var(--text-primary)">Adicione seus primeiros links</h3>
                        <p class="text-theme-secondary">Você pode adicionar até 3 links agora. É opcional — pode pular.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_linkError))
                    {
                        <div class="alert-theme mb-3" style="border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08)">
                            <i class="bi bi-exclamation-circle" style="color:var(--danger)"></i> @_linkError
                        </div>
                    }

                    @for (int i = 0; i < _initialLinks.Count; i++)
                    {
                        var idx = i;
                        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1rem;margin-bottom:.75rem">
                            <div style="display:flex;gap:.75rem;align-items:center">
                                <div style="width:32px;height:32px;border-radius:50%;background:rgba(85,124,242,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                    <span style="font-weight:700;font-size:.85rem;color:var(--accent)">@(idx + 1)</span>
                                </div>
                                <div style="flex:1;display:flex;gap:.5rem;flex-direction:column">
                                    <input class="form-control-theme w-100"
                                           placeholder="Título (ex: Instagram)"
                                           value="@_initialLinks[idx].Title"
                                           @oninput="e => UpdateLinkTitle(idx, e.Value?.ToString() ?? string.Empty)"
                                           maxlength="80" />
                                    <input class="form-control-theme w-100"
                                           placeholder="URL (ex: https://instagram.com/seuperfil)"
                                           value="@_initialLinks[idx].Url"
                                           @oninput="e => UpdateLinkUrl(idx, e.Value?.ToString() ?? string.Empty)"
                                           maxlength="2048" />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <button class="btn-ghost" @onclick="() => _step = 3">
                            <i class="bi bi-arrow-left me-1"></i> Voltar
                        </button>
                        <div class="d-flex gap-2">
                            <button class="btn-ghost" @onclick="SkipLinks">
                                Pular por agora
                            </button>
                            <button class="btn-accent" @onclick="SaveLinksAsync" disabled="@_creatingLinks">
                                @if (_creatingLinks) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Salvar e continuar <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* ───── Step 5: Success ───── *@
            @if (_step == 5)
            {
                <div class="animate-fade-in-up text-center">
                    <div style="width:80px;height:80px;border-radius:50%;background:rgba(34,197,94,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
                        <i class="bi bi-check-lg" style="font-size:2.5rem;color:var(--success)"></i>
                    </div>
                    <h3 style="font-weight:700;color:var(--text-primary)">Sua página está pronta!</h3>
                    <p class="text-theme-secondary mb-4">Parabéns! Compartilhe com o mundo.</p>

                    <div class="d-flex align-items-center gap-2 justify-content-center mb-4" style="max-width:420px;margin:0 auto">
                        <input class="form-control-theme flex-grow-1" readonly value="@CreatedPageUrl" />
                        <button class="btn-ghost" @onclick="CopyUrl"><i class="bi bi-clipboard"></i></button>
                    </div>

                    <div class="d-flex flex-column gap-2" style="max-width:320px;margin:0 auto">
                        <button class="btn-accent" style="width:100%;justify-content:center" @onclick="GoToEditor">
                            <i class="bi bi-pencil me-1"></i> Personalizar minha página
                        </button>
                        <button class="btn-ghost" style="width:100%;justify-content:center" @onclick="GoToDashboard">
                            <i class="bi bi-grid me-1"></i> Ir ao dashboard
                        </button>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    int _step = 1;
    string _selectedProfile = "";
    string? _selectedTemplateId;
    string _templateFilter = "todos";
    string _pageTitle = "", _pageSlug = "", _pageBio = "";
    string _error = "";
    bool _creating, _slugEdited;
    Guid _createdPageId;
    string _createdSlug = "";
    Guid _userId;

    // AI helper state
    string _aiDescription = "";
    bool _aiLoading;
    string _aiError = "";
    string _aiSuccessMsg = "";
    int _aiCallCount = 0; // max 3 per session

    string StepMaxWidth => _step switch { 2 => "780px", 3 or 4 => "900px", _ => "640px" };
    int VisualStep => _step switch { 4 => 3, 5 => 4, _ => _step };
    int TotalVisualSteps => 4;

    // Links step state
    record InitialLink(string Title, string Url);
    List<InitialLink> _initialLinks = [new("", ""), new("", ""), new("", "")];
    string _linkError = "";
    bool _creatingLinks;

    void UpdateLinkTitle(int idx, string val) => _initialLinks[idx] = _initialLinks[idx] with { Title = val };
    void UpdateLinkUrl(int idx, string val) => _initialLinks[idx] = _initialLinks[idx] with { Url = val };

    static readonly (string id, string label, string icon, string desc)[] _profileTypes =
    [
        ("creator",  "Criador",       "bi-camera-reels",     "Influenciador, youtuber"),
        ("business", "Negócio",       "bi-briefcase",        "Loja, serviço, empresa"),
        ("dev",      "Desenvolvedor", "bi-code-slash",       "Portfólio técnico"),
        ("artist",   "Artista",       "bi-palette",          "Design, fotografia, arte"),
        ("musician", "Músico",        "bi-music-note-beamed","Banda, produtor, DJ"),
        ("other",    "Outro",         "bi-person",           "Qualquer perfil"),
    ];

    string PublicPagePrefix => new Uri(new Uri(Nav.BaseUri), "p/").ToString();
    string CreatedPageUrl => string.IsNullOrWhiteSpace(_createdSlug)
        ? PublicPagePrefix
        : new Uri(new Uri(Nav.BaseUri), $"p/{_createdSlug}").ToString();

    IEnumerable<PageTemplate> FilteredTemplates => _templateFilter == "todos"
        ? Templates.All
        : Templates.All.Where(t => t.Category == _templateFilter);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _userId = auth.User.GetUserId();
        var pages = await PageSvc.GetUserPagesAsync(_userId);
        if (pages.Count > 0)
            Nav.NavigateTo("/dashboard");
    }

    void GoToStep2()
    {
        // Auto-select matching template based on profile
        _selectedTemplateId = _selectedProfile switch
        {
            "creator"  => "creator",
            "business" => "business",
            "dev"      => "dev-portfolio",
            "artist"   => "artist",
            "musician" => "musician",
            _          => null
        };
        _step = 2;
    }

    void OnTitleInput(ChangeEventArgs e)
    {
        _pageTitle = e.Value?.ToString() ?? string.Empty;
        if (!_slugEdited)
        {
            var slug = ToSlug(_pageTitle);
            _pageSlug = slug.Length > 30 ? slug[..30] : slug;
        }
    }

    void OnSlugInput(ChangeEventArgs e)
    {
        _pageSlug = e.Value?.ToString() ?? string.Empty;
        _slugEdited = true;
    }

    async Task CreatePageAsync()
    {
        if (string.IsNullOrWhiteSpace(_pageTitle) || string.IsNullOrWhiteSpace(_pageSlug))
        { _error = "Preencha o nome e o endereço da página."; return; }

        _creating = true; _error = string.Empty;
        var result = await PageSvc.CreateAsync(_userId, new()
        {
            Title = _pageTitle,
            Slug = _pageSlug,
            Bio = string.IsNullOrWhiteSpace(_pageBio) ? null : _pageBio,
            TemplateId = _selectedTemplateId
        });

        if (result.IsFailure)
        { _error = result.Error!; _creating = false; return; }

        var page = result.Value!;
        await PageSvc.PublishAsync(_userId, page.Id);

        _createdPageId = page.Id;
        _createdSlug = _pageSlug;
        _creating = false;
        _step = 4;
    }

    async Task CopyUrl() => await JS.InvokeAsync<bool>("umblink.copyToClipboard", CreatedPageUrl);
    void GoToEditor() => Nav.NavigateTo($"/editor/{_createdPageId}");
    void GoToDashboard() => Nav.NavigateTo("/dashboard");

    void SkipLinks() => _step = 5;

    async Task SaveLinksAsync()
    {
        _linkError = "";
        var validLinks = _initialLinks
            .Where(l => !string.IsNullOrWhiteSpace(l.Title) && !string.IsNullOrWhiteSpace(l.Url))
            .ToList();

        foreach (var link in validLinks)
        {
            if (!Uri.TryCreate(link.Url, UriKind.Absolute, out var uri) ||
                (uri.Scheme != "https" && uri.Scheme != "http" && uri.Scheme != "mailto"))
            {
                _linkError = $"URL inválida: {link.Url}";
                return;
            }
        }

        if (validLinks.Count == 0)
        {
            _step = 5;
            return;
        }

        _creatingLinks = true;
        try
        {
            foreach (var link in validLinks)
            {
                await LinkSvc.AddAsync(_userId, _createdPageId, new()
                {
                    Title = link.Title,
                    Url = link.Url
                });
            }
            _step = 5;
        }
        catch
        {
            _linkError = "Erro ao salvar os links. Você pode adicioná-los no editor.";
        }
        finally
        {
            _creatingLinks = false;
        }
    }

    PageDto GetPreviewDto()
    {
        var themeConfig = BuildPreviewThemeConfig();
        return new(Guid.Empty, Guid.Empty, "preview",
            string.IsNullOrEmpty(_pageTitle) ? "Seu nome" : _pageTitle,
            string.IsNullOrWhiteSpace(_pageBio) ? null : _pageBio,
            null, PageStatus.Draft, themeConfig, 0);
    }

    string BuildPreviewThemeConfig()
    {
        var tpl = _selectedTemplateId != null
            ? Templates.All.FirstOrDefault(t => t.Id == _selectedTemplateId)
            : null;
        if (tpl != null) return tpl.ThemeConfig;

        var theme = Themes.All[0];
        return System.Text.Json.JsonSerializer.Serialize(new {
            themeId = theme.Id, bgColor = theme.DefaultBg, buttonStyle = "rounded",
            buttonColor = theme.DefaultButtonColor, buttonTextColor = theme.DefaultButtonTextColor,
            textColor = theme.DefaultTextColor, titleFont = "inter", linkFont = "inter",
            spacing = "normal", avatarShape = "circle"
        });
    }

    static string ToSlug(string title)
    {
        var s = title.ToLowerInvariant().Trim()
            .Replace('ã','a').Replace('â','a').Replace('á','a').Replace('à','a')
            .Replace('ê','e').Replace('é','e').Replace('è','e')
            .Replace('î','i').Replace('í','i').Replace('ì','i')
            .Replace('ô','o').Replace('ó','o').Replace('ò','o').Replace('õ','o')
            .Replace('ú','u').Replace('û','u').Replace('ù','u').Replace('ç','c');
        s = System.Text.RegularExpressions.Regex.Replace(s, @"[^a-z0-9\s-]", "");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", "-");
        return System.Text.RegularExpressions.Regex.Replace(s, @"-+", "-").Trim('-');
    }

    async Task GenerateWithAI()
    {
        if (_aiCallCount >= 3 || string.IsNullOrWhiteSpace(_aiDescription)) return;
        _aiLoading = true;
        _aiError = "";
        _aiSuccessMsg = "";
        StateHasChanged();
        try
        {
            var req = new GenerateProfileRequest(_aiDescription, _selectedProfile);
            var resp = await Http.PostAsJsonAsync("/api/ai/generate-profile", req);
            if (resp.IsSuccessStatusCode)
            {
                var profile = await resp.Content.ReadFromJsonAsync<GenerateProfileResponse>();
                if (profile is not null)
                {
                    _pageTitle = profile.Title;
                    _pageSlug = profile.SlugSuggestion;
                    _pageBio = profile.Bio;
                    _aiCallCount++;
                    _aiSuccessMsg = "Gerado com IA — edite à vontade antes de continuar";
                }
            }
            else if ((int)resp.StatusCode == 503)
            {
                _aiError = "Não foi possível gerar, tente preencher manualmente";
            }
            else
            {
                _aiError = "Erro ao gerar perfil";
            }
        }
        catch
        {
            _aiError = "Não foi possível gerar, tente preencher manualmente";
        }
        finally
        {
            _aiLoading = false;
            StateHasChanged();
        }
    }
}
