@page "/auth/login"
@layout PublicLayout
@inject SignInManager<AppUser> SignInMgr
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Identity
@using UmbLink.Infrastructure.Identity

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm" style="width:100%;max-width:420px">
        <div class="card-body p-4">
            <h4 class="card-title mb-1 fw-bold">Entrar</h4>
            <p class="text-muted small mb-4">Bem-vindo de volta!</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <InputText @bind-Value="_model.Email" type="email" class="form-control" />
                    <ValidationMessage For="() => _model.Email" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <InputText @bind-Value="_model.Password" type="password" class="form-control" />
                    <ValidationMessage For="() => _model.Password" class="text-danger small" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="_model.RememberMe" class="form-check-input" id="remember" />
                    <label class="form-check-label" for="remember">Lembrar-me</label>
                </div>
                <button class="btn btn-primary w-100 @(_loading ? "disabled" : "")" type="submit">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Entrar
                </button>
            </EditForm>

            @if (_googleEnabled)
            {
                <div class="text-center my-3 text-muted small">ou</div>
                <a href="/auth/google-login" class="btn btn-outline-secondary w-100">
                    <img src="https://www.google.com/favicon.ico" width="16" class="me-2" alt="" />
                    Continuar com Google
                </a>
            }

            <div class="d-flex justify-content-between mt-3 small">
                <a href="/auth/forgot-password">Esqueci minha senha</a>
                <a href="/auth/register">Criar conta</a>
            </div>
        </div>
    </div>
</div>

@code {
    readonly LoginModel _model = new();
    bool _loading;
    string _error = "";
    bool _googleEnabled;

    [Inject] IConfiguration Config { get; set; } = default!;
    [SupplyParameterFromQuery] string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        _googleEnabled = !string.IsNullOrEmpty(Config["Google:ClientId"]);
    }

    async Task HandleLogin()
    {
        _loading = true;
        _error = "";
        var result = await SignInMgr.PasswordSignInAsync(_model.Email!, _model.Password!, _model.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Nav.NavigateTo(ReturnUrl ?? "/dashboard");
            return;
        }
        _error = result.IsLockedOut ? "Conta bloqueada temporariamente." : "E-mail ou senha inválidos.";
        _loading = false;
    }

    class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string? Email { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string? Password { get; set; }
        public bool RememberMe { get; set; }
    }
}
