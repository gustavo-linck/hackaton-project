@page "/auth/login"
@layout PublicLayout

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm" style="width:100%;max-width:420px">
        <div class="card-body p-4">
            <h4 class="card-title mb-1 fw-bold">Entrar</h4>
            <p class="text-muted small mb-4">Bem-vindo de volta!</p>

            @if (!string.IsNullOrEmpty(_errorMsg))
            {
                <div class="alert alert-danger py-2">@_errorMsg</div>
            }

            <form method="post" action="/auth/do-login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input name="email" type="email" class="form-control" placeholder="voce@exemplo.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <div class="input-group">
                        <input name="password" type="@(_showPassword ? "text" : "password")"
                               class="form-control" required />
                        <button type="button" class="btn btn-outline-secondary"
                                @onclick="() => _showPassword = !_showPassword"
                                tabindex="-1">
                            <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input name="remember" value="true" type="checkbox" class="form-check-input" id="remember" />
                    <label class="form-check-label" for="remember">Lembrar-me</label>
                </div>

                <button class="btn btn-primary w-100" type="submit">Entrar</button>
            </form>

            @if (_googleEnabled)
            {
                <div class="text-center my-3 text-muted small">ou</div>
                <a href="/auth/google-login" class="btn btn-outline-secondary w-100">
                    <img src="https://www.google.com/favicon.ico" width="16" class="me-2" alt="" />
                    Continuar com Google
                </a>
            }

            <div class="d-flex justify-content-between mt-3 small">
                <a href="/auth/forgot-password">Esqueci minha senha</a>
                <a href="/auth/register">Criar conta</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] string? Error { get; set; }
    [Inject] IConfiguration Config { get; set; } = default!;

    bool _showPassword;
    bool _googleEnabled;
    string _errorMsg = "";

    protected override void OnInitialized()
    {
        _googleEnabled = !string.IsNullOrEmpty(Config["Google:ClientId"]);
        _errorMsg = Error switch {
            "invalid" => "E-mail ou senha inválidos.",
            "locked"  => "Conta bloqueada temporariamente. Tente novamente em breve.",
            "required"=> "Preencha todos os campos.",
            _         => ""
        };
    }
}
