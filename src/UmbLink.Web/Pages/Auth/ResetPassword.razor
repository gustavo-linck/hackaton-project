@page "/auth/reset-password"
@layout PublicLayout
@inject UserManager<AppUser> UserMgr
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Identity
@using UmbLink.Infrastructure.Identity

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-theme-secondary">
    <div class="card-theme-static shadow-sm" style="width:100%;max-width:420px;background:var(--bg-card);border:1px solid var(--border);border-radius:.5rem">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1">Nova senha</h4>
            <p class="text-theme-muted small mb-4">Crie uma nova senha segura.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleReset">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Nova senha</label>
                    <InputText @bind-Value="_model.Password" type="password" class="form-control-theme" />
                    <ValidationMessage For="() => _model.Password" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirmar senha</label>
                    <InputText @bind-Value="_model.ConfirmPassword" type="password" class="form-control-theme" />
                    <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
                </div>
                <button class="btn btn-accent w-100" type="submit">Redefinir senha</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    readonly ResetModel _model = new();
    string _error = "";

    [SupplyParameterFromQuery] string? Email { get; set; }
    [SupplyParameterFromQuery] string? Token { get; set; }

    async Task HandleReset()
    {
        if (_model.Password != _model.ConfirmPassword)
        {
            _error = "As senhas não coincidem.";
            return;
        }
        var user = await UserMgr.FindByEmailAsync(Email ?? "");
        if (user == null) { Nav.NavigateTo("/auth/login"); return; }

        var result = await UserMgr.ResetPasswordAsync(user, Token ?? "", _model.Password!);
        if (result.Succeeded)
            Nav.NavigateTo("/auth/login?reset=1");
        else
            _error = string.Join(", ", result.Errors.Select(e => e.Description));
    }

    class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(6)]
        public string? Password { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string? ConfirmPassword { get; set; }
    }
}
