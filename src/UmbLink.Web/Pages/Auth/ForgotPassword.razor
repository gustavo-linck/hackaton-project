@page "/auth/forgot-password"
@layout PublicLayout
@inject UserManager<AppUser> UserMgr
@using Microsoft.AspNetCore.Identity
@using UmbLink.Infrastructure.Identity

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-theme-secondary">
    <div class="card-theme-static shadow-sm" style="width:100%;max-width:420px;background:var(--bg-card);border:1px solid var(--border);border-radius:.5rem">
        <div class="card-body p-4">
            @if (_sent)
            {
                <div class="text-center">
                    <i class="bi bi-envelope-check fs-1 text-success"></i>
                    <h5 class="mt-3">Verifique seu e-mail</h5>
                    <p class="text-theme-muted">Se existir uma conta com esse e-mail, enviaremos as instruções de recuperação.</p>
                    <a href="/auth/login" class="btn btn-accent">Voltar ao login</a>
                </div>
            }
            else
            {
                <h4 class="fw-bold mb-1">Recuperar senha</h4>
                <p class="text-theme-muted small mb-4">Informe seu e-mail e enviaremos um link de redefinição.</p>

                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <InputText @bind-Value="_model.Email" type="email" class="form-control-theme" />
                        <ValidationMessage For="() => _model.Email" class="text-danger small" />
                    </div>
                    <button class="btn btn-accent w-100" type="submit">Enviar link</button>
                </EditForm>
                <p class="text-center mt-3 small"><a href="/auth/login">Voltar ao login</a></p>
            }
        </div>
    </div>
</div>

@code {
    readonly ForgotModel _model = new();
    bool _sent;

    async Task HandleSubmit()
    {
        // Always show success (never reveal if email exists)
        var user = await UserMgr.FindByEmailAsync(_model.Email!);
        if (user != null)
        {
            var token = await UserMgr.GeneratePasswordResetTokenAsync(user);
            // In production: send email. For demo, token is logged/ignored.
            _ = token;
        }
        _sent = true;
    }

    class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string? Email { get; set; }
    }
}
