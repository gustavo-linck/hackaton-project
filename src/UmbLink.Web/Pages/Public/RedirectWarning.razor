@page "/redirect-warning"
@layout PublicLayout
@inject NavigationManager Nav

<PageTitle>Redirecionamento externo — UmbLink</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-theme-secondary">
    <div class="card shadow-sm" style="max-width:420px;width:100%;border-radius:16px;border:1px solid var(--border);background:var(--bg-card)">
        <div class="card-body p-4 text-center">
            @if (_isValid)
            {
                <div style="margin-bottom:1.25rem">
                    <i class="bi bi-box-arrow-up-right" style="font-size:2.5rem;color:var(--accent)"></i>
                </div>
                <p style="color:var(--text-muted);font-size:.9rem;margin-bottom:.5rem">
                    Você está sendo redirecionado para:
                </p>
                <p style="font-weight:700;font-size:1.05rem;word-break:break-all;color:var(--text-primary);margin-bottom:1rem">
                    @_host
                </p>
                <p style="font-size:.8rem;color:var(--text-muted);margin-bottom:1.5rem">
                    Este link foi adicionado por um usuário do UmbLink.<br />
                    Não temos controle sobre o conteúdo externo.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn-accent" @onclick="Continue">
                        Continuar <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <button class="btn-ghost" @onclick="Cancel">
                        Cancelar
                    </button>
                </div>
            }
            else
            {
                <div style="margin-bottom:1.25rem">
                    <i class="bi bi-exclamation-triangle" style="font-size:2.5rem;color:var(--danger)"></i>
                </div>
                <p style="font-weight:600;color:var(--text-primary);margin-bottom:1rem">Link inválido</p>
                <button class="btn-ghost" @onclick="Cancel">
                    <i class="bi bi-arrow-left me-1"></i>Voltar
                </button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Url { get; set; }

    bool _isValid;
    string _host = "";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Url) &&
            (Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
             Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)) &&
            Uri.TryCreate(Url, UriKind.Absolute, out var uri))
        {
            _isValid = true;
            _host = uri.Host;
        }
    }

    void Continue()
    {
        if (_isValid && Url is not null)
            Nav.NavigateTo(Url, forceLoad: true);
    }

    void Cancel() => Nav.NavigateTo("/");
}
