@page "/"
@layout PublicLayout

<div class="min-vh-100 d-flex flex-column" style="background:linear-gradient(135deg,#0f0c29,#302b63,#24243e)">
    <!-- Navbar -->
    <nav class="navbar px-4 py-3">
        <span class="navbar-brand text-white fw-bold fs-5">UmbLink</span>
        <div class="ms-auto d-flex gap-2">
            <a href="/auth/login" class="btn btn-sm btn-outline-light">Entrar</a>
            <a href="/auth/register" class="btn btn-sm btn-primary">Criar grátis</a>
        </div>
    </nav>

    <!-- Hero -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center text-white text-center px-3">
        <div>
            <span class="badge bg-primary mb-3 px-3 py-2">Novo — planos a partir de R$19/mês</span>
            <h1 class="display-4 fw-bold mb-3">
                Todos os seus links<br />em <span class="text-warning">um só lugar</span>
            </h1>
            <p class="lead text-white-50 mb-5" style="max-width:520px;margin:0 auto">
                Crie sua página personalizada em segundos e compartilhe com o mundo. Ideal para criadores, profissionais e marcas.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/auth/register" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-rocket-takeoff me-2"></i>Começar grátis
                </a>
                <a href="/p/joao-silva" class="btn btn-outline-light btn-lg px-4" target="_blank">
                    <i class="bi bi-eye me-2"></i>Ver exemplo
                </a>
            </div>
            <p class="text-white-50 small mt-3">Sem cartão de crédito. Plano gratuito para sempre.</p>
        </div>
    </div>

    <!-- Features strip -->
    <div class="py-4 px-3 text-center text-white-50 small border-top border-secondary">
        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <span><i class="bi bi-check-circle-fill text-success me-1"></i>Página gratuita</span>
            <span><i class="bi bi-check-circle-fill text-success me-1"></i>Analytics em tempo real</span>
            <span><i class="bi bi-check-circle-fill text-success me-1"></i>Temas personalizáveis</span>
            <span><i class="bi bi-check-circle-fill text-success me-1"></i>Domínio próprio (Pro)</span>
        </div>
    </div>
</div>
