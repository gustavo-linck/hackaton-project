@page "/editor/{pageId:guid}"
@attribute [Authorize]
@inject IPageService PageSvc
@inject ILinkService LinkSvc
@inject ISubscriptionService SubSvc
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Editor — UmbLink</PageTitle>

@if (_page is null && !_loading)
{
    <div class="d-flex align-items-center justify-content-center" style="height:100vh;color:var(--text-muted)">
        Página não encontrada.
    </div>
}
else
{
    <div class="d-flex flex-column editor-fullheight">
        <!-- Toolbar -->
        <div class="editor-toolbar">
            <a href="/dashboard" class="btn-ghost" style="padding:.375rem .625rem">
                <i class="bi bi-arrow-left"></i>
            </a>
            <span style="font-weight:600;font-size:.9rem;color:var(--text-primary)">@_page?.Title</span>
            <div class="ms-auto d-flex gap-2 align-items-center">
                @if (_page is not null)
                {
                    <a href="/p/@_editSlug" target="_blank" class="btn-ghost" title="Ver página">
                        <i class="bi bi-eye"></i><span class="d-none d-md-inline">Ver</span>
                    </a>
                    <a href="/dashboard/metrics/@PageId" class="btn-ghost" title="Métricas">
                        <i class="bi bi-bar-chart"></i>
                    </a>
                    <a href="/editor/@PageId/domain" class="btn-ghost" title="Personalizar Link">
                        <i class="bi bi-link-45deg"></i>
                    </a>
                }
                <button class="btn-accent" @onclick="SavePage" disabled="@_saving" style="padding:.375rem 1rem">
                    @if (_saving) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <i class="bi bi-check-lg"></i> }
                    Salvar
                </button>
            </div>
        </div>

        <div class="row g-0 flex-grow-1 overflow-hidden">
            <!-- Editor panel -->
            <div class="col-lg-7 editor-panel">
                <LoadingSpinner Loading="_loading">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert-theme" style="margin-bottom:1rem;border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08)">
                            <i class="bi bi-exclamation-circle" style="color:var(--danger)"></i>
                            @_error
                        </div>
                    }

                    <!-- Page settings -->
                    <div class="editor-card">
                        <div class="editor-card-header">Informações da página</div>
                        <div class="editor-card-body">
                            <div style="margin-bottom:.75rem">
                                <label class="form-label-theme">Título</label>
                                <input value="@_editTitle" @oninput="OnTitleInput" class="form-control-theme w-100" maxlength="60" />
                                <div style="font-size:.7rem;text-align:right;color:@(_editTitle.Length >= 54 ? "var(--danger)" : "var(--text-muted)")">@_editTitle.Length / 60</div>
                            </div>
                            <div style="margin-bottom:.75rem">
                                <label class="form-label-theme">Endereço</label>
                                <div class="d-flex">
                                    <span class="form-control-theme d-flex align-items-center text-theme-muted"
                                          style="border-radius:10px 0 0 10px;border-right:none;font-size:.75rem;padding:.4rem .5rem;white-space:nowrap">@PublicPagePrefix</span>
                                    <input value="@_editSlug" @oninput="e => _editSlug = e.Value?.ToString() ?? string.Empty" class="form-control-theme w-100" style="border-radius:0 10px 10px 0" maxlength="30" />
                                </div>
                                <div style="font-size:.7rem;text-align:right;color:@(_editSlug.Length >= 27 ? "var(--danger)" : "var(--text-muted)")">@_editSlug.Length / 30</div>
                            </div>
                            <div style="margin-bottom:.75rem">
                                <label class="form-label-theme">Bio</label>
                                <textarea value="@_editBio" @oninput="OnBioInput" class="form-control-theme w-100" rows="2" maxlength="200"></textarea>
                                <div style="font-size:.7rem;text-align:right;color:@(_editBio.Length >= 180 ? "var(--danger)" : "var(--text-muted)")">@_editBio.Length / 200</div>
                            </div>
                            <div>
                                <label class="form-label-theme">Avatar (URL da imagem)</label>
                                <input value="@_editAvatarUrl" @oninput="OnAvatarInput" class="form-control-theme w-100" placeholder="https://..." maxlength="2048" />
                            </div>
                        </div>
                    </div>

                    <!-- Links -->
                    <div class="editor-card">
                        <div class="editor-card-header">
                            <span>Links</span>
                            <button class="btn-accent" style="padding:.25rem .625rem;font-size:.75rem" @onclick="() => _showAddLink = true">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        @if (_links.Count == 0)
                        {
                            <div class="text-center" style="padding:2rem 1rem">
                                <i class="bi bi-link-45deg" style="font-size:2rem;color:var(--text-muted);display:block;margin-bottom:.5rem"></i>
                                <p class="text-theme-muted" style="font-size:.85rem;margin-bottom:.75rem">Você ainda não tem links.</p>
                                <button class="btn-accent" style="font-size:.8rem" @onclick="() => _showAddLink = true">
                                    <i class="bi bi-plus-lg"></i>Adicionar meu primeiro link
                                </button>
                            </div>
                        }
                        else
                        {
                            <div @ref="_sortableEl">
                                @foreach (var link in _links)
                                {
                                    <div class="link-item" style="@(link.IsActive ? "" : "opacity:.5")">
                                        <span class="drag-handle text-theme-muted" style="cursor:grab"><i class="bi bi-grip-vertical"></i></span>
                                        <div class="flex-grow-1" style="min-width:0">
                                            <div style="font-weight:600;font-size:.85rem;color:var(--text-primary)">@link.Title</div>
                                            <div class="text-theme-muted" style="font-size:.7rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@link.Url</div>
                                        </div>
                                        <button class="btn-ghost" style="padding:.25rem .5rem" @onclick="() => ToggleLink(link)"
                                                title="@(link.IsActive ? "Desativar" : "Ativar")">
                                            <i class="bi @(link.IsActive ? "bi-eye" : "bi-eye-slash")"></i>
                                        </button>
                                        <button class="btn-ghost" style="padding:.25rem .5rem;color:var(--danger)" @onclick="() => DeleteLink(link)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Appearance -->
                    <div class="editor-card">
                        <div class="editor-card-header" style="cursor:pointer" @onclick="() => _showThemePanel = !_showThemePanel">
                            <span>Aparência</span>
                            <i class="bi @(_showThemePanel ? "bi-chevron-up" : "bi-chevron-down")" style="color:var(--text-muted)"></i>
                        </div>
                        @if (_showThemePanel)
                        {
                            <div class="editor-card-body">
                                <label class="form-label-theme" style="font-weight:600">Tema</label>
                                <div class="row g-2 mb-3">
                                    @foreach (var theme in Themes.All)
                                    {
                                        var isLocked = theme.IsPremium && !(_sub?.PlanName is "Pro" or "Business");
                                        <div class="col-6">
                                            <div style="border:1px solid @(_selectedThemeId == theme.Id ? "var(--accent)" : "var(--border)");
                                                        border-radius:10px;padding:.5rem .75rem;cursor:pointer;display:flex;align-items:center;gap:.5rem;
                                                        background:@(_selectedThemeId == theme.Id ? "rgba(99,102,241,0.08)" : "transparent");
                                                        opacity:@(isLocked ? ".6" : "1");transition:all .2s ease"
                                                 @onclick="() => SelectThemeOrUpgrade(theme)">
                                                <div style="width:20px;height:20px;border-radius:50%;background:@theme.DefaultBg;border:1px solid var(--border);flex-shrink:0"></div>
                                                <span style="font-size:.8rem;color:var(--text-primary)">@theme.Name</span>
                                                @if (isLocked)
                                                {
                                                    <span class="ms-auto"><i class="bi bi-lock-fill" style="font-size:.65rem;color:var(--warning)"></i></span>
                                                }
                                                else if (theme.IsPremium)
                                                {
                                                    <span class="badge-theme ms-auto" style="background:rgba(245,158,11,0.1);color:var(--warning);font-size:.55rem">Pro</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <label class="form-label-theme" style="font-weight:600">Estilo do botão</label>
                                <div class="d-flex gap-1 mb-3 flex-wrap">
                                    @foreach (var (key, label) in new[] { ("rounded","Redondo"), ("pill","Pílula"), ("square","Quadrado"), ("outline","Contorno") })
                                    {
                                        <button type="button"
                                                class="@(_btnStyleKey == key ? "btn-accent" : "btn-ghost")"
                                                style="font-size:.75rem;padding:.3rem .75rem"
                                                @onclick="() => { _btnStyleKey = key; ApplyTheme(); }">@label</button>
                                    }
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label-theme">Cor do botão</label>
                                        <input type="color" class="form-control form-control-color w-100" value="@_btnColor"
                                               style="border-radius:10px;border:1px solid var(--border)"
                                               @oninput="e => { _btnColor = e.Value?.ToString() ?? _btnColor; ApplyTheme(); }" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label-theme">Cor do texto</label>
                                        <input type="color" class="form-control form-control-color w-100" value="@_textColor"
                                               style="border-radius:10px;border:1px solid var(--border)"
                                               @oninput="e => { _textColor = e.Value?.ToString() ?? _textColor; ApplyTheme(); }" />
                                    </div>
                                </div>

                                <label class="form-label-theme" style="font-weight:600">Formato do avatar</label>
                                <div class="d-flex gap-1 mb-3">
                                    <button type="button"
                                            class="@(_avatarShape == "circle" ? "btn-accent" : "btn-ghost")"
                                            style="font-size:.75rem;padding:.3rem .75rem"
                                            @onclick='() => { _avatarShape = "circle"; ApplyTheme(); }'>
                                        <i class="bi bi-circle me-1"></i>Círculo
                                    </button>
                                    <button type="button"
                                            class="@(_avatarShape == "square" ? "btn-accent" : "btn-ghost")"
                                            style="font-size:.75rem;padding:.3rem .75rem"
                                            @onclick='() => { _avatarShape = "square"; ApplyTheme(); }'>
                                        <i class="bi bi-square me-1"></i>Quadrado
                                    </button>
                                </div>

                                <!-- Gradient editor -->
                                <label class="form-label-theme" style="font-weight:600">Fundo gradiente</label>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <button type="button"
                                            class="@(_useGradient ? "btn-accent" : "btn-ghost")"
                                            style="font-size:.75rem;padding:.3rem .75rem"
                                            @onclick="() => { _useGradient = !_useGradient; ApplyTheme(); }">
                                        <i class="bi @(_useGradient ? "bi-toggle-on" : "bi-toggle-off") me-1"></i>
                                        @(_useGradient ? "Ativado" : "Desativado")
                                    </button>
                                </div>
                                @if (_useGradient)
                                {
                                    <!-- Presets -->
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        @foreach (var preset in GradientPresets)
                                        {
                                            <div style="width:32px;height:32px;border-radius:8px;cursor:pointer;
                                                        background:linear-gradient(135deg,@preset.color1,@preset.color2);
                                                        border:2px solid @(_gradColor1 == preset.color1 && _gradColor2 == preset.color2 ? "var(--accent)" : "transparent");
                                                        transition:border .2s ease"
                                                 title="@preset.label"
                                                 @onclick="() => { _gradColor1 = preset.color1; _gradColor2 = preset.color2; _gradDirection = preset.dir; ApplyTheme(); }">
                                            </div>
                                        }
                                    </div>

                                    <!-- Custom colors -->
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="form-label-theme" style="font-size:.7rem">Cor 1</label>
                                            <input type="color" class="form-control form-control-color w-100" value="@_gradColor1"
                                                   style="border-radius:10px;border:1px solid var(--border)"
                                                   @oninput="e => { _gradColor1 = e.Value?.ToString() ?? _gradColor1; ApplyTheme(); }" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label-theme" style="font-size:.7rem">Cor 2</label>
                                            <input type="color" class="form-control form-control-color w-100" value="@_gradColor2"
                                                   style="border-radius:10px;border:1px solid var(--border)"
                                                   @oninput="e => { _gradColor2 = e.Value?.ToString() ?? _gradColor2; ApplyTheme(); }" />
                                        </div>
                                    </div>

                                    <!-- Direction -->
                                    <label class="form-label-theme" style="font-size:.7rem">Direção</label>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        @foreach (var (dir, label) in new[] { ("to right","→"), ("to bottom","↓"), ("135deg","↘"), ("to right bottom","⬊"), ("circle","◉") })
                                        {
                                            var isRadial = dir == "circle";
                                            <button type="button"
                                                    class="@((_gradType == "radial" && isRadial) || (_gradType == "linear" && _gradDirection == dir && !isRadial) ? "btn-accent" : "btn-ghost")"
                                                    style="font-size:.75rem;padding:.25rem .5rem;min-width:32px"
                                                    @onclick='() => { if (isRadial) { _gradType = "radial"; } else { _gradType = "linear"; _gradDirection = dir; } ApplyTheme(); }'>
                                                @label
                                            </button>
                                        }
                                    </div>

                                    <!-- Gradient preview -->
                                    <div style="height:40px;border-radius:10px;
                                                background:@(_gradType == "radial" ? $"radial-gradient(circle, {_gradColor1}, {_gradColor2})" : $"linear-gradient({_gradDirection}, {_gradColor1}, {_gradColor2})");
                                                border:1px solid var(--border)"></div>
                                }
                            </div>
                        }
                    </div>
                </LoadingSpinner>
            </div>

            <!-- Preview panel -->
            <div class="col-lg-5 d-none d-lg-flex preview-panel">
                @if (_page is not null)
                {
                    <PagePreview Page="_page" Links="_links" />
                }
            </div>
        </div>
    </div>

    <!-- Mobile preview FAB -->
    <div class="d-lg-none">
        <button class="preview-fab" @onclick="() => _showMobilePreview = true" title="Visualizar">
            <i class="bi bi-eye"></i>
        </button>
    </div>

    @if (_showMobilePreview)
    {
        <div class="modal-theme-backdrop" style="z-index:1060" @onclick="() => _showMobilePreview = false">
            <div class="mobile-preview-modal" @onclick:stopPropagation="true">
                <div class="d-flex justify-content-between align-items-center p-3" style="border-bottom:1px solid var(--border)">
                    <span style="font-weight:600;color:var(--text-primary)">Preview</span>
                    <button class="btn-ghost" @onclick="() => _showMobilePreview = false" style="padding:.25rem .5rem">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="d-flex justify-content-center align-items-start p-3" style="overflow-y:auto;flex:1">
                    @if (_page is not null)
                    {
                        <PagePreview Page="_page" Links="_links" />
                    }
                </div>
            </div>
        </div>
    }
}

<!-- Add link modal -->
@if (_showAddLink)
{
    <div class="modal-theme-backdrop">
        <div class="modal-theme">
            <div class="modal-theme-header">
                <h5>Adicionar Link</h5>
                <button class="btn-ghost" @onclick="() => _showAddLink = false" style="padding:.25rem .5rem">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-theme-body">
                @if (!string.IsNullOrEmpty(_linkError))
                {
                    <div class="alert-theme" style="margin-bottom:1rem;border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08)">
                        <i class="bi bi-exclamation-circle" style="color:var(--danger)"></i>
                        @_linkError
                    </div>
                }
                <div style="margin-bottom:1rem">
                    <label class="form-label-theme">Título</label>
                    <input value="@_newLinkTitle" @oninput="e => _newLinkTitle = e.Value?.ToString() ?? string.Empty" class="form-control-theme w-100" placeholder="Meu Instagram" maxlength="80" />
                    <div style="font-size:.7rem;text-align:right;color:@(_newLinkTitle.Length >= 72 ? "var(--danger)" : "var(--text-muted)")">@_newLinkTitle.Length / 80</div>
                </div>
                <div>
                    <label class="form-label-theme">URL</label>
                    <input @bind="_newLinkUrl" type="url" class="form-control-theme w-100" placeholder="https://..." maxlength="2048" />
                </div>
            </div>
            <div class="modal-theme-footer">
                <button class="btn-ghost" @onclick="() => _showAddLink = false">Cancelar</button>
                <button class="btn-accent" @onclick="AddLink">Adicionar</button>
            </div>
        </div>
    </div>
}

<UpgradeModal @bind-Visible="_showUpgrade" Message="@_upgradeMessage" />
<ToastContainer @ref="_toast" />

@code {
    [Parameter] public Guid PageId { get; set; }
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    PageDto? _page;
    List<LinkDto> _links = [];
    SubscriptionDto? _sub;
    bool _loading = true;
    bool _saving;
    string _error = "", _linkError = "";
    string _editTitle = "", _editSlug = "", _editBio = "", _editAvatarUrl = "";
    bool _showAddLink;
    bool _showMobilePreview;
    string _newLinkTitle = "", _newLinkUrl = "";
    bool _showUpgrade;
    string _upgradeMessage = "";
    ToastContainer? _toast;
    ElementReference _sortableEl;
    DotNetObjectReference<Editor>? _dotnetRef;
    Guid _userId;

    // Theme editor state
    string _selectedThemeId = "minimal-light";
    string _btnColor = "#111111";
    string _btnTextColor = "#ffffff";
    string _textColor = "#111111";
    string _btnStyleKey = "rounded";
    string _avatarShape = "circle";
    bool _showThemePanel = true;

    // Gradient editor state
    bool _useGradient;
    string _gradColor1 = "#667eea", _gradColor2 = "#764ba2";
    string _gradDirection = "135deg";
    string _gradType = "linear";

    static readonly (string id, string label, string color1, string color2, string dir)[] GradientPresets =
    [
        ("sunset",  "Pôr do sol",  "#ffecd2", "#fcb69f", "135deg"),
        ("ocean",   "Oceano",      "#667eea", "#764ba2", "135deg"),
        ("aurora",  "Aurora",      "#a8edea", "#fed6e3", "135deg"),
        ("forest",  "Floresta",    "#134e5e", "#71b280", "180deg"),
        ("fire",    "Fogo",        "#f12711", "#f5af19", "135deg"),
        ("candy",   "Candy",       "#ff6a88", "#ff99ac", "to right"),
        ("midnight","Meia-noite",  "#232526", "#414345", "180deg"),
        ("neon",    "Neon",        "#00f260", "#0575e6", "135deg"),
    ];
    bool _sortableInitialized;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _userId = auth.User.GetUserId();
        var pages = await PageSvc.GetUserPagesAsync(_userId);
        _page = pages.FirstOrDefault(p => p.Id == PageId);
        if (_page is not null)
        {
            _editTitle = _page.Title;
            _editSlug = _page.Slug;
            _editBio = _page.Bio ?? "";
            _editAvatarUrl = _page.AvatarUrl ?? "";
            _links = await PageSvc.GetLinksAsync(PageId);
            _sub = await SubSvc.GetAsync(_userId);

            try {
                var cfg = System.Text.Json.JsonDocument.Parse(_page.ThemeConfig).RootElement;
                string GetStr(string k, string fb) => cfg.TryGetProperty(k, out var v) ? v.GetString() ?? fb : fb;
                bool GetBool(string k) => cfg.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
                _selectedThemeId = GetStr("themeId", "minimal-light");
                _btnColor        = GetStr("buttonColor", "#111111");
                _btnTextColor    = GetStr("buttonTextColor", "#ffffff");
                _textColor       = GetStr("textColor", "#111111");
                _btnStyleKey     = GetStr("buttonStyle", "rounded");
                _avatarShape     = GetStr("avatarShape", "circle");
                _useGradient     = GetBool("useGradient");
                _gradColor1      = GetStr("gradColor1", "#667eea");
                _gradColor2      = GetStr("gradColor2", "#764ba2");
                _gradDirection   = GetStr("gradDirection", "135deg");
                _gradType        = GetStr("gradType", "linear");
            } catch { }
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only initialize sortable when the <ul> element is actually in the DOM (has links)
        // Prevents a JS circuit crash when element reference is null/empty
        if (!_sortableInitialized && _page is not null && _sortableEl.Id is not null)
        {
            _sortableInitialized = true;
            _dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("umblink.initSortable", _sortableEl, _dotnetRef);
        }
    }

    [JSInvokable]
    public async Task OnReorder(int oldIndex, int newIndex)
    {
        var item = _links[oldIndex];
        _links.RemoveAt(oldIndex);
        _links.Insert(newIndex, item);
        var orderedIds = _links.Select(l => l.Id).ToList();
        await LinkSvc.ReorderAsync(_userId, PageId, orderedIds);
        StateHasChanged();
    }

    async Task SavePage()
    {
        _saving = true; _error = "";
        var result = await PageSvc.UpdateAsync(_userId, PageId, new() {
            Title = _editTitle, Slug = _editSlug, Bio = _editBio,
            AvatarUrl = _editAvatarUrl,
            ThemeConfig = BuildThemeConfig()
        });
        if (result.IsSuccess)
        {
            _page = result.Value;
            _toast?.Show("Página salva!");
        }
        else _error = result.Error!;
        _saving = false;
    }

    string BuildThemeConfig()
    {
        var theme = Themes.All.FirstOrDefault(t => t.Id == _selectedThemeId) ?? Themes.All[0];
        return System.Text.Json.JsonSerializer.Serialize(new {
            themeId         = _selectedThemeId,
            bgColor         = theme.DefaultBg,
            buttonStyle     = _btnStyleKey,
            buttonColor     = _btnColor,
            buttonTextColor = _btnTextColor,
            textColor       = _textColor,
            titleFont       = "inter",
            linkFont        = "inter",
            spacing         = "normal",
            avatarShape     = _avatarShape,
            useGradient     = _useGradient,
            gradColor1      = _gradColor1,
            gradColor2      = _gradColor2,
            gradDirection   = _gradDirection,
            gradType        = _gradType
        });
    }

    void ApplyTheme()
    {
        var newConfig = BuildThemeConfig();
        _page = _page! with { ThemeConfig = newConfig };
    }

    void SelectThemeOrUpgrade(ThemeDefinition theme)
    {
        var isLocked = theme.IsPremium && !(_sub?.PlanName is "Pro" or "Business");
        if (isLocked)
        {
            _upgradeMessage = $"O tema \"{theme.Name}\" está disponível nos planos Pro e Business. Faça upgrade para desbloquear!";
            _showUpgrade = true;
            return;
        }
        SelectTheme(theme);
    }

    void SelectTheme(ThemeDefinition theme)
    {
        _selectedThemeId = theme.Id;
        _btnColor        = theme.DefaultButtonColor;
        _btnTextColor    = theme.DefaultButtonTextColor;
        _textColor       = theme.DefaultTextColor;
        ApplyTheme();
    }

    async Task AddLink()
    {
        _linkError = "";
        var result = await LinkSvc.AddAsync(_userId, PageId, new() { Title = _newLinkTitle, Url = _newLinkUrl });
        if (result.IsFailure)
        {
            if (result.LimitError is not null) { _showUpgrade = true; _upgradeMessage = result.LimitError.Message; _showAddLink = false; }
            else _linkError = result.Error!;
            return;
        }
        _links.Add(result.Value!);
        _showAddLink = false;
        _newLinkTitle = _newLinkUrl = "";
    }

    async Task ToggleLink(LinkDto link)
    {
        await LinkSvc.ToggleActiveAsync(_userId, link.Id);
        var idx = _links.IndexOf(link);
        _links[idx] = link with { IsActive = !link.IsActive };
    }

    async Task DeleteLink(LinkDto link)
    {
        await LinkSvc.DeleteAsync(_userId, link.Id);
        _links.Remove(link);
    }

    void OnTitleInput(ChangeEventArgs e)
    {
        _editTitle = e.Value?.ToString() ?? string.Empty;
        if (_page is not null) _page = _page with { Title = _editTitle };
    }

    void OnBioInput(ChangeEventArgs e)
    {
        _editBio = e.Value?.ToString() ?? string.Empty;
        if (_page is not null) _page = _page with { Bio = string.IsNullOrEmpty(_editBio) ? null : _editBio };
    }

    void OnAvatarInput(ChangeEventArgs e)
    {
        _editAvatarUrl = e.Value?.ToString() ?? string.Empty;
        if (_page is not null) _page = _page with { AvatarUrl = string.IsNullOrEmpty(_editAvatarUrl) ? null : _editAvatarUrl };
    }

    string PublicPagePrefix => new Uri(new Uri(Nav.BaseUri), "p/").ToString();

    public async ValueTask DisposeAsync()
    {
        _dotnetRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
