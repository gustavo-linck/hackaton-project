@inherits LayoutComponentBase
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]

@* Mobile top bar — visible only on small screens *@
<div class="d-flex d-md-none align-items-center bg-dark text-white px-3 py-2 sticky-top" style="z-index:1045">
    <button class="btn btn-sm btn-outline-secondary text-white border-secondary me-2"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#adminSidebar"
            aria-controls="adminSidebar">
        <i class="bi bi-list fs-5"></i>
    </button>
    <span class="fw-bold text-white">Admin Umbler</span>
</div>

@* Offcanvas sidebar — slides in on mobile *@
<div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel" style="width:220px">
    <div class="offcanvas-header border-bottom border-secondary">
        <h6 class="offcanvas-title text-uppercase text-muted small mb-0" id="adminSidebarLabel">Admin Umbler</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body p-3 d-flex flex-column">
        <nav class="nav flex-column gap-1">
            <a href="/admin" class="nav-link text-white"><i class="bi bi-bar-chart me-2"></i>Dashboard</a>
            <a href="/admin/users" class="nav-link text-white"><i class="bi bi-people me-2"></i>Usuários</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
            <a href="/dashboard" class="nav-link text-muted small"><i class="bi bi-arrow-left me-1"></i>Voltar ao app</a>
        </div>
    </div>
</div>

<div class="d-flex min-vh-100">
    @* Desktop sidebar — hidden on mobile *@
    <aside class="bg-dark text-white p-3 flex-shrink-0 d-none d-md-flex flex-column" style="width:220px">
        <h6 class="text-uppercase text-muted small mb-3">Admin Umbler</h6>
        <nav class="nav flex-column gap-1">
            <a href="/admin" class="nav-link text-white"><i class="bi bi-bar-chart me-2"></i>Dashboard</a>
            <a href="/admin/users" class="nav-link text-white"><i class="bi bi-people me-2"></i>Usuários</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary">
            <a href="/dashboard" class="nav-link text-muted small"><i class="bi bi-arrow-left me-1"></i>Voltar ao app</a>
        </div>
    </aside>
    <main class="flex-grow-1 p-3 p-md-4">@Body</main>
</div>
