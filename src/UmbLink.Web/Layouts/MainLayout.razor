@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="min-vh-100 d-flex flex-column" style="background:var(--bg-primary)">
    <nav class="navbar-theme d-flex align-items-center flex-wrap">
        <a class="nav-brand" href="/dashboard">UmbLink</a>

        <div class="ms-auto d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <span class="d-none d-md-inline text-theme-secondary" style="font-size:.8rem">
                        <i class="bi bi-person-circle me-1"></i>@context.User.FindFirst("display_name")?.Value
                    </span>

                    @* Nav links — hidden on mobile, shown on md+ *@
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <a href="/dashboard" class="nav-link-theme">Dashboard</a>
                        <a href="/plans" class="nav-link-theme">Planos</a>
                        <a href="/my-plan" class="nav-link-theme">Meu Plano</a>
                        <a href="/account/settings" class="nav-link-theme">Configurações</a>
                        <AuthorizeView Roles="Admin" Context="adminCtx">
                            <Authorized>
                                <a href="/admin" class="nav-link-theme" style="color:var(--warning)">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    <button class="theme-toggle" @onclick="ToggleTheme" title="Alternar tema">
                        <i class="bi @(_isDark ? "bi-sun" : "bi-moon-stars")"></i>
                    </button>

                    @* Hamburger — visible only on mobile *@
                    <button class="btn-ghost d-md-none" @onclick="ToggleMenu" aria-label="Menu">
                        <i class="bi @(_menuOpen ? "bi-x-lg" : "bi-list") fs-5"></i>
                    </button>

                    @* Logout — always visible on desktop, hidden on mobile (in dropdown instead) *@
                    <form action="/auth/logout" method="post" class="d-none d-md-block">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-ghost" style="color:var(--danger)">
                            <i class="bi bi-box-arrow-right"></i> Sair
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <button class="theme-toggle" @onclick="ToggleTheme" title="Alternar tema">
                        <i class="bi @(_isDark ? "bi-sun" : "bi-moon-stars")"></i>
                    </button>
                    <a href="/auth/login" class="btn-ghost">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>

    @* Mobile dropdown menu *@
    <AuthorizeView>
        <Authorized>
            @if (_menuOpen)
            {
                <div class="d-md-none px-3 py-2 border-bottom"
                     style="background:var(--navbar-bg);backdrop-filter:blur(12px)">
                    <a href="/dashboard" class="nav-link-theme d-block py-2" @onclick="CloseMenu">
                        <i class="bi bi-grid me-2"></i>Dashboard
                    </a>
                    <a href="/plans" class="nav-link-theme d-block py-2" @onclick="CloseMenu">
                        <i class="bi bi-card-list me-2"></i>Planos
                    </a>
                    <a href="/my-plan" class="nav-link-theme d-block py-2" @onclick="CloseMenu">
                        <i class="bi bi-person-badge me-2"></i>Meu Plano
                    </a>
                    <a href="/account/settings" class="nav-link-theme d-block py-2" @onclick="CloseMenu">
                        <i class="bi bi-gear me-2"></i>Configurações
                    </a>
                    <AuthorizeView Roles="Admin" Context="adminMobileCtx">
                        <Authorized>
                            <a href="/admin" class="nav-link-theme d-block py-2" style="color:var(--warning)" @onclick="CloseMenu">
                                <i class="bi bi-shield-lock me-2"></i>Admin
                            </a>
                        </Authorized>
                    </AuthorizeView>
                    <div class="border-top mt-2 pt-2">
                        <form action="/auth/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="btn-ghost w-100 text-start" style="color:var(--danger)">
                                <i class="bi bi-box-arrow-right me-2"></i>Sair
                            </button>
                        </form>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="footer-theme">
        &copy; @DateTime.Now.Year UmbLink by Umbler
    </footer>
</div>

@code {
    bool _isDark;
    bool _menuOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("umblink.getTheme");
            _isDark = theme == "dark";
            StateHasChanged();
        }
    }

    async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("umblink.setTheme", _isDark ? "dark" : "light");
    }

    void ToggleMenu() => _menuOpen = !_menuOpen;
    void CloseMenu() => _menuOpen = false;
}
